# ---- Database (Supabase Postgres) ----
# Use the "Session" / direct connection string. URL-encode special chars in the password
# ('+' -> %2B, '&' -> %26). Append ?sslmode=require.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# Supabase public project settings (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Storage (server-side only; keep the service-role key secret).
# Create a private bucket named "documents" (or set SUPABASE_STORAGE_BUCKET).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Session signing secret (long random string in production)
SESSION_SECRET=

# First administrator created on first start (choose your own strong password)
ADMIN_EMAIL=you@your-domain.com
ADMIN_PASSWORD=

# E-mail (optional). Password/API key must live in env only.
SMTP_PASSWORD=
# EMAIL_API_KEY=
# CRON_SECRET=
# APP_URL=http://localhost:3000
